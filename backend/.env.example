# Copy to .env and adjust.

ENVIRONMENT=dev
LOG_LEVEL=INFO

# Default: SQLite at backend/data/cqa.db (works from any working directory).
# Override only if needed, e.g. Postgres: postgresql+asyncpg://user:pass@host/db
# DATABASE_URL=sqlite+aiosqlite:///./data/cqa.db

# Comma-separated origins, or * for any (demo).
CORS_ORIGINS=*

# Organizer dataset API (GET, group_id appended as query param). Leave empty to import from file.
ORGANIZER_API_URL=

# ML evaluation service: mock (built-in heuristics) or http (the ML team's service).
ML_PROVIDER=mock
ML_SERVICE_URL=http://localhost:8001
ML_TIMEOUT_S=180
ML_MAX_RETRIES=2

# Parallel evaluations against the ML service.
QUEUE_WORKERS=3

SEED_DEFAULT_CHECKLIST=true

# Copy to .env and adjust.

ENVIRONMENT=dev
LOG_LEVEL=INFO

# SQLite (default) — single file, no setup. For Postgres: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./data/cqa.db

# Comma-separated origins, or * for any (demo).
CORS_ORIGINS=*

# Organizer dataset API: the «Открыть GET для DEV» link from the task PDF, as is (it is signed).
# group_id in it is replaced by the one requested. Leave empty to import from a file.
ORGANIZER_API_URL=

# ML evaluation: mock (built-in heuristics), http (the ML team's service)
# or openai (any OpenAI-compatible API, settings below).
ML_PROVIDER=mock
ML_SERVICE_URL=http://localhost:8001
ML_TIMEOUT_S=180
ML_MAX_RETRIES=2
# Mock only: seconds per evaluation, to rehearse a slow model (polling, batches).
ML_MOCK_DELAY_S=0

# OpenAI-compatible cloud LLM: ML_PROVIDER=openai, and bot handoff analysis whenever a key is set.
# OPENAI_BASE_URL also takes OpenRouter etc. For a local model use ML_PROVIDER=http with the ML
# team's service (ml/): plain Ollama here truncates long chats (4096-token window) and qwen
# thinks for minutes. If the evaluation model and handoff analysis both run on this machine,
# the backend sends them to the GPU one at a time.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1
# Leave empty for models that only accept the default temperature (gpt-5.x).
OPENAI_TEMPERATURE=0
# Reasoning models: none | low | medium | high. Empty = provider default.
OPENAI_REASONING_EFFORT=
OPENAI_TIMEOUT_S=120
# USD per 1M tokens, for the cost shown on each evaluation.
OPENAI_PRICE_INPUT_PER_1M=2.0
OPENAI_PRICE_OUTPUT_PER_1M=8.0
# Mask IIN, card numbers, phones, e-mails and IBANs before text goes to a non-local LLM.
PII_MASKING=true
# Language of explanations: ru | kk | en.
OUTPUT_LANGUAGE=ru

# Attention queue: evaluations scoring below this are flagged.
ATTENTION_SCORE_THRESHOLD=60

# Parallel evaluations against the ML service (1 for a single local GPU with Ollama).
QUEUE_WORKERS=3
# POST /api/evaluations waits this long for the verdict before returning the in-progress state.
EVALUATION_WAIT_S=85

SEED_DEFAULT_CHECKLIST=true

# Serve ../frontend at / from the backend (one origin for UI and API). FRONTEND_DIR overrides the path.
SERVE_FRONTEND=true

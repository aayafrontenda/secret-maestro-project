# All values are optional: the defaults are shown below.
MAESTRO_OLLAMA_URL=http://127.0.0.1:11434
# qwen3.5:4b is about twice as fast and less accurate.
MAESTRO_MODEL=qwen3.5:9b
MAESTRO_NUM_CTX=8192
MAESTRO_NUM_PREDICT=384
MAESTRO_THINK=false
# Thinking for some questions only, e.g. 04,06,07 (criterion codes), probe keys such as summarized,
# generic (new criteria) or all. Listed ones think, the rest do not; unset = MAESTRO_THINK for all.
MAESTRO_THINK_ON=
# Token limit for a call with thinking (the thinking text counts against it).
MAESTRO_THINK_PREDICT=4096
MAESTRO_SEED=42
MAESTRO_TIMEOUT=300
# Force all model layers onto the GPU (e.g. 99). About 7% faster for qwen3.5:9b on an
# 8 GB card, but leaves almost no free VRAM; unset lets Ollama decide.
MAESTRO_NUM_GPU=
#
# --- Main model backend: ollama (default, local) or openai (OpenAI or any OpenAI-compatible API) ---
MAESTRO_BACKEND=ollama
# For MAESTRO_BACKEND=openai. Gemini works through its OpenAI-compatible endpoint:
#   MAESTRO_OPENAI_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OPENAI_API_KEY=<Gemini API key>
MAESTRO_OPENAI_URL=https://api.openai.com/v1
MAESTRO_OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
# reasoning_effort for reasoning models (gpt-5.x), e.g. low; empty = provider default.
MAESTRO_OPENAI_REASONING=
#
# --- Optional separate model for criteria without built-in rules (a changed or new criterion) ---
# Empty = the main model scores them too. Example: gemini-3.6-flash on the generic path, Qwen on the rest.
MAESTRO_GENERIC_MODEL=
# Defaults to MAESTRO_OPENAI_URL / OPENAI_API_KEY when empty.
MAESTRO_GENERIC_URL=
MAESTRO_GENERIC_API_KEY=
MAESTRO_GENERIC_REASONING=
#
# Ollama server settings (set them for the Ollama app, not for this service), about 15% faster:
#   OLLAMA_FLASH_ATTENTION=1
#   OLLAMA_KV_CACHE_TYPE=q8_0
